		{"id":"cd49c98df5a936a4","type":"text","text":"split the roman numerals into: 1000 200 11 2","x":-16,"y":295,"width":380,"height":70},
		{"id":"184bf0196af565e1","type":"text","text":"apply the algortihm:\n\n((((1000)/200)*11)-2) = 53\n\nsum the core:\n\n5 + 3 = 8 (vault 53 is opened by Key 8)","x":-16,"y":455,"width":407,"height":225},
		{"id":"a6f448795e556b0b","type":"text","text":"The Watering Can can be refilled here \n\n(must be at least partially emptied)","x":1620,"y":4847,"width":320,"height":133},
